# Copy to .env and edit. Every setting is optional; defaults are paper trading on live market data.

# paper (default): simulated fills against the real order book. live: real orders.
KC_MODE=paper
# prod or demo. Try live mode on demo first: https://demo.kalshi.co
KC_KALSHI_ENV=prod

# Only needed for live mode (Kalshi > Account > API keys)
# KC_KEY_ID=
# KC_PRIVATE_KEY_PATH=./kalshi-private-key.pem
# Live on prod also needs this exact phrase:
# KC_LIVE_CONFIRM=yes-real-money

# Paper bankroll and how it splits into buckets (fractions must sum to 1).
# Add a bucket named after a Kalshi category (e.g. sports) to ring-fence it.
KC_BANKROLL=1000
KC_BUCKETS=crypto=0.4,general=0.6

# Risk
KC_KELLY_FRACTION=0.25
KC_MAX_STAKE=25
KC_MAX_DAILY_LOSS=150
KC_MAX_OPEN_POSITIONS=25
KC_MAX_MARKET_EXPOSURE=50
KC_MIN_EDGE=0.03

# Bot crew: any of crypto15m, whale, momentum (empty = council only)
KC_BOTS=crypto15m,whale,momentum
KC_CRYPTO_ASSETS=BTC,ETH,SOL,XRP,DOGE

# Council
KC_COUNCIL_QUORUM=2
KC_FORECAST_TTL_HOURS=12

# Built-in Claude crew (kalshi-council run --crew). Needs ANTHROPIC_API_KEY or `ant auth login`.
# KC_ANTHROPIC_MODEL=claude-opus-5-5
# KC_AGENT_INTERVAL_MINUTES=20
# KC_PERSONAS_PATH=./my-personas.json
